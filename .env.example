VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_MAPBOX_TOKEN=your_mapbox_public_token
# Optional accepted aliases:
# VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token
#
# Optional: public https URL of your Character.AI bot or profile (opens in a new tab from the walkthrough).
# Character.AI does not offer an in-app API; this is only a deep link for visitors.
# VITE_CHARACTER_AI_URL=https://character.ai/chat/your-character-id
#
# Natural narration (OpenAI neural TTS, ASMR-style instructions — deploy Edge Function first):
# VITE_USE_CLOUD_NARRATION=true
# Requires VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY. Set OPENAI_API_KEY in Supabase → Edge Functions → Secrets,
# then: supabase functions deploy tts-narration
#
# Pre-launch automation (optional):
#   npm run smoke — production build + HTTP smoke for SPA shells on core routes
#   npm run check:api — verifies places_nearby RPC exists (uses URL + anon key above)
